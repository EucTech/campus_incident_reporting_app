rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function schoolPath(schoolId) {
      return /databases/$(database)/documents/schools/$(schoolId);
    }

    function me() {
      return get(userPath(request.auth.uid)).data;
    }

    function active() {
      return signedIn() && request.auth.token.email_verified == true && me().get('deletedAt', null) == null;
    }

    function memberOf(schoolId) {
      return active() && me().schoolId == schoolId && get(schoolPath(schoolId)).data.status == 'approved';
    }

    function staffOf(schoolId) {
      return memberOf(schoolId) && me().role in ['staff', 'admin'];
    }

    function adminOf(schoolId) {
      return memberOf(schoolId) && me().role == 'admin';
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validDomain(domain) {
      return domain is string
        && domain.matches('^[a-z0-9-]+([.][a-z0-9-]+)+$')
        && !(domain in ['gmail.com', 'googlemail.com', 'yahoo.com', 'ymail.com', 'outlook.com',
          'hotmail.com', 'live.com', 'icloud.com', 'aol.com', 'proton.me', 'protonmail.com']);
    }

    function validJoin(uid) {
      let data = request.resource.data;
      return changedKeys().hasOnly(['schoolId', 'role'])
        && data.schoolId is string
        && (
          (data.role == 'student'
            && get(/databases/$(database)/documents/domains/$(myEmail().split('@')[1])).data.schoolId == data.schoolId
            && get(schoolPath(data.schoolId)).data.status == 'approved')
          || (data.role == 'staff'
            && get(/databases/$(database)/documents/schools/$(data.schoolId)/invites/$(myEmail())).data.status == 'pending')
          || (data.role == 'admin' && getAfter(schoolPath(data.schoolId)).data.adminUid == uid)
        );
    }

    function validIncident() {
      let data = request.resource.data;
      return data.title is string && data.title.size() >= 5 && data.title.size() <= 80
        && data.description is string && data.description.size() >= 15 && data.description.size() <= 1000
        && data.location is string && data.location.size() >= 2 && data.location.size() <= 80
        && data.category in ['facilities', 'water', 'electricity', 'furniture', 'sanitation', 'safety', 'other']
        && data.severity in ['low', 'medium', 'high'];
    }

    function togglesOwnAffected() {
      let before = resource.data.affectedBy.toSet();
      let after = request.resource.data.affectedBy.toSet();
      return after.difference(before).union(before.difference(after)).hasOnly([request.auth.uid]);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || adminOf(resource.data.schoolId));

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'schoolId', 'createdAt'])
        && request.resource.data.role == 'none'
        && request.resource.data.schoolId == null
        && request.resource.data.email == myEmail();

      allow update: if signedIn() && request.auth.uid == uid
        && resource.data.get('deletedAt', null) == null
        && (
          (!changedKeys().hasAny(['role', 'schoolId'])
            && (!changedKeys().hasAny(['email']) || request.resource.data.email == myEmail()))
          || (resource.data.schoolId == null && validJoin(uid))
        );

      allow update: if adminOf(resource.data.schoolId)
        && resource.data.role == 'staff'
        && changedKeys().hasOnly(['role', 'schoolId'])
        && request.resource.data.role == 'none'
        && request.resource.data.schoolId == null;
    }

    match /domains/{domain} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['schoolId'])
        && getAfter(schoolPath(request.resource.data.schoolId)).data.adminUid == request.auth.uid
        && domain in getAfter(schoolPath(request.resource.data.schoolId)).data.studentDomains;
    }

    match /schools/{schoolId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'studentDomains', 'status', 'adminUid', 'adminEmail', 'createdAt'])
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.adminEmail == myEmail()
        && request.resource.data.status == 'approved'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.studentDomains is list
        && request.resource.data.studentDomains.size() == 1
        && validDomain(request.resource.data.studentDomains[0])
        && me().schoolId == null;

      match /invites/{email} {
        allow read: if adminOf(schoolId) || (signedIn() && email == myEmail());

        allow create: if adminOf(schoolId)
          && email == email.lower()
          && request.resource.data.keys().hasOnly(['email', 'role', 'status', 'invitedBy', 'invitedAt'])
          && request.resource.data.email == email
          && request.resource.data.role == 'staff'
          && request.resource.data.status == 'pending';

        allow update: if signedIn() && email == myEmail()
          && resource.data.status == 'pending'
          && changedKeys().hasOnly(['status', 'acceptedAt'])
          && request.resource.data.status == 'accepted'
          && getAfter(userPath(request.auth.uid)).data.schoolId == schoolId;

        allow delete: if adminOf(schoolId);
      }

      match /incidents/{incidentId} {
        allow read: if memberOf(schoolId);

        allow create: if memberOf(schoolId) && validIncident()
          && request.resource.data.reporterId == request.auth.uid
          && request.resource.data.status == 'submitted';

        allow update: if staffOf(schoolId)
          && changedKeys().hasOnly(['status', 'timeline', 'updatedAt']);

        allow update: if memberOf(schoolId) && validIncident()
          && resource.data.reporterId == request.auth.uid
          && resource.data.status == 'submitted'
          && changedKeys().hasOnly(['title', 'description', 'location', 'category', 'severity', 'imageUrl', 'imagePath', 'updatedAt']);

        allow update: if memberOf(schoolId)
          && changedKeys().hasOnly(['affectedBy'])
          && togglesOwnAffected();

        allow delete: if staffOf(schoolId)
          || (memberOf(schoolId) && resource.data.reporterId == request.auth.uid && resource.data.status == 'submitted');
      }
    }

    match /{path=**}/invites/{email} {
      allow read: if signedIn() && resource.data.email == myEmail();
    }
  }
}
