rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function verified() {
      return request.auth != null
        && request.auth.token.email.matches('.*@(alustudent|alueducation)[.]com$')
        && request.auth.token.email_verified == true;
    }

    match /incidents/{uid}/{fileName} {
      allow read: if verified();
      allow create, update: if verified() && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if verified() && request.auth.uid == uid;
    }

    match /avatars/{uid}/{fileName} {
      allow read: if verified();
      allow create, update: if verified() && request.auth.uid == uid
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if verified() && request.auth.uid == uid;
    }
  }
}
